.env
# Blanket-ignore JSON: client_secret.json and youtube_token*.json carry
# credentials and must never be committed. Safe ones are re-included below.
*.json
!package.json
!samples/*.json
# Command Center (Next.js app) config — no credentials, and Vercel needs the
# lockfile for reproducible `npm ci` builds.
!command-center/tsconfig.json
!command-center/package-lock.json
output/
logs/
history/
__pycache__/
*.pyc
*.pyo
.DS_Store

# Synthesized audio — regenerated on demand by tools/generate_assets.py.
# Commit real recordings as .mp3 instead; the loaders check mp3 before wav,
# so a committed .mp3 always overrides the generated fallback.
assets/sfx/*.wav
assets/music/*.wav
